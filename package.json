{
  "name": "shinkansen-tests",
  "version": "0.0.1",
  "private": true,
  "description": "Shinkansen Chrome Extension 的 Playwright 自動化測試 harness",
  "type": "module",
  "scripts": {
    "test": "playwright test && jest --config jest.config.cjs",
    "test:regression": "playwright test test/regression/",
    "test:unit": "playwright test test/unit/",
    "test:version": "playwright test test/version-check.spec.js",
    "test:jest": "jest --config jest.config.cjs",
    "test:all": "playwright test && jest --config jest.config.cjs",
    "debug": "node tools/debug-harness.js",
    "pdf-layout": "node tools/pdf-layout-harness.js",
    "pdf-snapshot": "node tools/pdf-layout-snapshot.js",
    "pdf-snapshot:update": "node tools/pdf-layout-snapshot.js --update",
    "pdf-snapshot:metrics": "node tools/pdf-layout-snapshot.js --metrics",
    "pdf-verify": "node tools/pdf-verify-harness.js",
    "pdf-structure-verify": "node tools/pdf-structure-verify.js",
    "docx-verify": "node tools/docx-verify-harness.js",
    "pdf-corpus": "node tools/pdf-corpus-verify.mjs",
    "pdf-corpus:fetch": "node tools/pdf-corpus-fetch.mjs",
    "pdf-corpus:index": "node tools/pdf-corpus-index.mjs",
    "pdf-corpus:pick": "node tools/pdf-corpus-index.mjs --pick",
    "pdf-corpus:visual": "node tools/pdf-visual-diff.mjs",
    "pdf-synth": "node test/tools/pdf-synth-fixtures.mjs"
  },
  "devDependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "@playwright/test": "^1.48.0",
    "jest": "^29.7.0",
    "jsdom": "^25.0.1",
    "pdf-lib": "^1.17.1",
    "pixelmatch": "^6.0.0",
    "pngjs": "^7.0.0"
  }
}
